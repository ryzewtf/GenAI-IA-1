# Traces and model weights never enter git.
*.gguf
*.safetensors
*.bin
!**/tests/**/*.bin
# Trace OUTPUT only. Anchored to the repo root so it cannot swallow the src/traces source package
# (an unanchored `traces/` matched `src/traces/`, so the collector's own code never got committed
# and Kaggle's clone could not import it).
/traces/
!src/traces/
scratch/
models/
corpora/*.jsonl



# Build
build/
_deps/
*.o
*.obj
*.so
*.dll
*.exe
!**/tests/**/*.exe

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Local secrets — never commit
.env
kaggle.json
hf_token*
*.json
*.jsonl
# OS
Thumbs.db
.DS_Store

*.md