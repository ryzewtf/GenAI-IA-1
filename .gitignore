# Traces and model weights never enter git.
*.gguf
*.safetensors
*.bin
!**/tests/**/*.bin
traces/
scratch/
models/
corpora/*.jsonl

# Upstream llama.cpp: source tree and prebuilt release binaries. Never vendored into this repo —
# the pinned commit lives in run.yaml (build.llama_cpp_commit) and each session re-clones it.
llama_cpp_pull/
llama-b*-bin-*/
cudart-llama-bin-*/

# Build
build/
_deps/
*.o
*.obj
*.so
*.dll
*.exe
!**/tests/**/*.exe

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Local secrets — never commit
.env
kaggle.json
hf_token*

# OS
Thumbs.db
.DS_Store

*.md